---
import '../styles/global.css';
import { SITE, KANZLEI, BETREIBER } from '../config';
import { CLUSTERS } from '../data/clusters';

interface Props {
  title: string;
  description?: string;
  schema?: object | object[];
  noindex?: boolean;
}
const { title, description = SITE.description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/ratgeber/', label: 'Ratgeber' },
  { href: '/rechner/', label: 'Pflichtteilsrechner' },
  { href: '/quick-check/', label: 'Quick-Check' },
  { href: '/anwalt-finden/', label: 'Anwalt finden' },
  { href: '/glossar/', label: 'Glossar' },
];
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  description: 'Ratgeberportal zum Pflichtteilsrecht, betrieben von ' + BETREIBER.firma + ', in Kooperation mit ' + KANZLEI.dat + '.',
};
const schemas = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="uwMJa9PYLOakQM9tKqVN6nXcdMP-IwfGD3hc9dG6kNk" />
    {(noindex || !SITE.live) && <meta name="robots" content={SITE.live ? 'noindex' : 'noindex, nofollow'} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <div class="partner-bar">
      Verständliches Wissen, persönliche Hilfe: Rechtliche Beratung erhalten Sie über unsere Partnerkanzlei, <a href="/anwalt-finden/#partnerkanzlei">{KANZLEI.nom}</a>.
    </div>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo" aria-label={`${SITE.name} – Startseite`}>
          <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#0e4a54"/><path d="M16 6l8 3.5v6c0 5.2-3.4 9.3-8 10.5-4.6-1.2-8-5.3-8-10.5v-6L16 6z" fill="none" stroke="#fff" stroke-width="2"/><path d="M12 16l3 3 5-6" fill="none" stroke="#f0a27c" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {SITE.name}
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav" onclick="const n=document.getElementById('nav');const o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)">Menü</button>
        <nav class="nav" id="nav" aria-label="Hauptnavigation">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a href="/anwalt-finden/#anfrage" class="btn btn-cta btn-small header-cta">Fall prüfen lassen</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a href="/" class="logo" style="color:#fff">{SITE.name}</a>
            <p style="margin-top:12px">Das Ratgeberportal rund um Pflichtteil und Pflichtteilsergänzung. Betrieben von {BETREIBER.firma} in Kooperation mit {KANZLEI.dat}.</p>
            <p class="small">Die Inhalte sind allgemeine Informationen und ersetzen keine Rechtsberatung im Einzelfall.</p>
          </div>
          <div>
            <h4>Ratgeber</h4>
            <ul>{CLUSTERS.map((c) => <li><a href={`/ratgeber/${c.slug}/`}>{c.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>Werkzeuge</h4>
            <ul>
              <li><a href="/rechner/">Pflichtteilsrechner</a></li>
              <li><a href="/quick-check/">Quick-Check</a></li>
              <li><a href="/anwalt-finden/">Anwalt finden</a></li>
              <li><a href="/glossar/">Glossar</a></li>
            </ul>
          </div>
          <div>
            <h4>Über uns</h4>
            <ul>
              <li><a href="/ueber-uns/">Über uns &amp; Transparenz</a></li>
              <li><a href="/impressum/">Impressum</a></li>
              <li><a href="/datenschutz/">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          © {new Date().getFullYear()} {BETREIBER.firma} · In Kooperation mit {KANZLEI.dat}. {BETREIBER.firma} erbringt keine Rechtsdienstleistungen. Das Portal wird von der Partnerkanzlei mit einer festen Vergütung finanziert, nicht pro Anfrage oder Mandat.
        </div>
      </div>
    </footer>
  </body>
</html>
