---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CLUSTERS } from '../../data/clusters';
const artikel = (await getCollection('artikel')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Ratgeber Pflichtteil: Alle Artikel" description="Alles zum Pflichtteil: Grundlagen, Berechnung, Durchsetzung, Fristen, Schenkungen und Gestaltung – verständlich erklärt und anwaltlich geprüft.">
  <section class="hero" style="padding-bottom:16px">
    <div class="container">
      <span class="eyebrow">Ratgeber</span>
      <h1>Pflichtteil verständlich erklärt</h1>
      <p class="lead muted" style="max-width:60ch">Von der ersten Frage nach der Enterbung bis zur Durchsetzung: unsere Artikel nach Themen sortiert.</p>
    </div>
  </section>
  <section class="container">
    {CLUSTERS.map((c) => {
      const list = artikel.filter((a) => a.data.cluster === c.slug);
      return (
        <div style="margin-bottom:40px">
          <h2><a href={`/ratgeber/${c.slug}/`} style="color:inherit;text-decoration:none">{c.name}</a></h2>
          <p class="muted">{c.intro}</p>
          {list.length ? (
            <div class="grid grid-3">
              {list.map((a) => (
                <a class="card card-link" href={`/ratgeber/${c.slug}/${a.id}/`}>
                  {a.data.pillar && <span class="badge">Grundlagenartikel</span>}
                  <h3 style="margin-top:10px;font-size:1.1rem">{a.data.title}</h3>
                  <p class="muted small" style="margin:0">{a.data.lesezeit} Min. Lesezeit</p>
                </a>
              ))}
            </div>
          ) : <p class="small muted">Artikel zu diesem Thema erscheinen in Kürze.</p>}
        </div>
      );
    })}
  </section>
</Base>
